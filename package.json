{
  "name": "cymalika-workspace",
  "version": "0.6.4",
  "description": "An open-source coding workspace for local models and compatible APIs",
  "author": "theprology",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/bundle.mjs && electron .",
    "format": "prettier --write source/web 'source/test*.mjs' desktop scripts docs '*.md' '*.json' .github",
    "format:check": "prettier --check source/web 'source/test*.mjs' desktop scripts docs '*.md' '*.json' .github",
    "test": "node scripts/test.mjs",
    "bundle": "node scripts/bundle.mjs",
    "dist:win": "npm run bundle && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run bundle && electron-builder --linux --x64 --publish never",
    "test:live-model": "node source/test-live-model.mjs",
    "test:live-computer": "node source/test-live-computer.mjs"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "prettier": "3.8.1"
  },
  "build": {
    "appId": "dev.theprology.cipher",
    "productName": "CyMalika",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "CyMalika-${version}-${arch}-setup.${ext}",
      "icon": "source/CyMalika.ico",
      "signExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "theprology",
      "artifactName": "CyMalika-${version}-${arch}.${ext}",
      "icon": "source/Icon.png",
      "syncDesktopName": true
    },
    "portable": {
      "artifactName": "CyMalika-${version}-${arch}-portable.${ext}"
    },
    "deb": {
      "compression": "gz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0",
        "python3",
        "python3-gi",
        "gir1.2-atspi-2.0",
        "wmctrl",
        "xdotool",
        "at-spi2-core",
        "zstd"
      ]
    },
    "asarUnpack": [
      "desktop/native/**"
    ]
  },
  "homepage": "https://github.com/theprology/Cymalika",
  "repository": {
    "type": "git",
    "url": "https://github.com/theprology/Cymalika.git"
  },
  "desktopName": "cymalika-workspace.desktop"
}
