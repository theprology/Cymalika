{
  "name": "cipher-workspace",
  "version": "0.3.0",
  "description": "An open-source coding workspace for local models and compatible APIs",
  "author": "theprology",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node scripts/bundle.mjs && electron .",
    "format": "prettier --write source/web 'source/test*.mjs' desktop scripts docs '*.md' '*.json' .github",
    "format:check": "prettier --check source/web 'source/test*.mjs' desktop scripts docs '*.md' '*.json' .github",
    "test": "node scripts/test.mjs",
    "bundle": "node scripts/bundle.mjs",
    "dist:win": "npm run bundle && electron-builder --win --x64 --publish never",
    "dist:linux": "npm run bundle && electron-builder --linux --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "prettier": "3.8.1"
  },
  "build": {
    "appId": "dev.theprology.cipher",
    "productName": "Cipher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "web/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Cipher-${version}-${arch}-setup.${ext}",
      "icon": "source/Cipher.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "theprology",
      "artifactName": "Cipher-${version}-${arch}.${ext}",
      "icon": "source/Icon.png",
      "syncDesktopName": true
    },
    "portable": {
      "artifactName": "Cipher-${version}-${arch}-portable.${ext}"
    },
    "deb": {
      "compression": "gz"
    }
  },
  "homepage": "https://github.com/theprology/cipher",
  "repository": {
    "type": "git",
    "url": "https://github.com/theprology/cipher.git"
  },
  "desktopName": "cipher-workspace.desktop"
}
